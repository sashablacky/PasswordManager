# Vault databases and logs hold the master password hash and user data: never ship or commit them
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-*
*.log
error.log
settings.json

# Secrets and local environment
.env
.env.*
*.pem
*.key

# Python, tests, coverage
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.venv/
.venv-macos/
venv/

# Build output
build/
dist/
*.spec
# ...except the build recipes, which are written by hand
!packaging/macos/PasswordManager.spec
!packaging/windows/PasswordManager.spec

# Local copies made before big changes
backups/

# macOS
.DS_Store
